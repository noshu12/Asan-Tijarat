# Asan Tijarat — Frontend environment example (FIXED, Batch 01)
# Copy this file to .env.local and fill in your own values.
# Pehli wali file me sirf 1 var thi — baaki 4 code me use hoti thi lekin
# kahin documented nahi thi.

# Backend ka public URL. Ye build time pe bake hota hai — Render ka URL
# badle to frontend ko dobara build/deploy karna lazmi hai.
# Production: https://<tumhara-render-backend>.onrender.com
# Agar unset rahe to app localhost:5000 pe call karegi aur prod me sab fail hoga.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Admin subdomain (agar use karte ho, jaise admin.asantijarat.com).
# Is host pe aane par API calls same-origin /backend-api/* se jati hain,
# taake asan_admin_token cookie host-only set ho.
# Na set ho to admin panel main host pe hi chalta hai aur 404-hiding nahi hogi.
NEXT_PUBLIC_ADMIN_HOST=admin.asantijarat.com
# Server-side copy — middleware.ts isko parhta hai (Vercel pe bhi set karo):
ADMIN_HOST=admin.asantijarat.com

# Backend ka server-side URL — /backend-api proxy isko use karta hai.
# Production me Render ka URL, local me localhost:5000.
BACKEND_INTERNAL_URL=http://localhost:5000

# Cloudflare Turnstile site key (public key).
# Na set ho to captcha widget render hi nahi hota aur backend bhi
# verification skip kar deta hai — bot protection band ho jati hai.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
