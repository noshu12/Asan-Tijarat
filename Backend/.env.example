# Asan Tijarat — Backend environment example (FIXED, Batch 01)
# Copy to .env and fill in real values. NEVER commit a real .env file.
# Pehli wali file me 10 vars missing thi aur 3 SMTP vars stale thi —
# ye file poori hai. Jo var "DEAD" likha hai, wo code kabhi nahi parhta.

# --- Core ---
PORT=5000
# Render pe ye lazmi "production" hona chahiye — Render khud set nahi karta.
# Na set ho to backend production me dev mode me chalta hai (loopback CORS
# allowed, secure:false cookies). Local dev me isko mat set karo ya "development" rakho.
NODE_ENV=production

# Browser origins allowed to call the API.
# Production me yahan apna REAL Vercel domain likho, bina trailing slash ke,
# jaise: https://asan-tijarat.vercel.app
# Preview deployments ke fresh URLs bhi yahan add karne partay hain.
# NEVER use "*" — credentials:true ke saath wildcard khatarnak hai.
CLIENT_ORIGIN=http://localhost:3000

# Frontend ka public URL — emails ke andar wale links ke liye use hota hai.
# Production: https://asan-tijarat.vercel.app
FRONTEND_URL=http://localhost:3000

# MongoDB connection string
#  - local:  mongodb://localhost:27017/asan_tijarat
#  - atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/asan_tijarat
# Render pe Atlas wala string dalo. Galat naam likha to localhost fallback
# nahi milega — server DB error dega, chup-chap local DB se connect nahi hoga.
MONGO_URI=mongodb://localhost:27017/asan_tijarat

# JWT signing secret (REQUIRED — server iske baghair start hi nahi hota)
#  - generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Email: Brevo HTTPS API (NOT SMTP) ---
# Render outbound SMTP block karta hai, is liye emails Brevo API se jati hain.
# EMAIL_HOST / EMAIL_PORT / EMAIL_PASS DEAD hain — code kabhi nahi parhta,
# is liye yahan se hata diye gaye hain. nodemailer bhi dead dependency hai.
# Brevo key na ho to OTP/reset/approval emails chup-chap kabhi nahi jati.
BREVO_API_KEY=your-brevo-api-key
# Brevo me verified sender hona lazmi hai, warna Brevo reject kar dega.
EMAIL_FROM=noreply@asantijarat.pk
EMAIL_FROM_NAME=Asan Tijarat
# Fallback sender (sirf tab use hota hai jab EMAIL_FROM na ho):
EMAIL_USER=your-email@gmail.com
# Contact form ki notification kis email pe jaye:
CONTACT_NOTIFY_EMAIL=your-email@gmail.com

# --- Uploads: Cloudinary (production) ---
# USE_CLOUDINARY=true + teeno credentials hon to hi Cloudinary on hota hai.
# Koi ek bhi missing ho to code chup-chap local disk pe gir jata hai — aur
# Render ki disk har redeploy/restart pe wipe ho jati hai (photos + KYC gayab).
# Production me ye chaaron lazmi set karo.
USE_CLOUDINARY=true
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# --- Payment: platform fee (Batch 05) ---
# Platform fee % on every order. UNDECIDED — default 0, so no fee is
# charged until this is set. Example when decided: PLATFORM_FEE_PERCENT=2
# (2% of the order total, deducted when the payment releases to the
# supplier). A full refund takes no fee. No gateway keys live here — there
# is no JazzCash/Stripe integration; payments are records only.
PLATFORM_FEE_PERCENT=2

# --- Security ---
# CNIC/NTN/utility-bill numbers AES-256-GCM se encrypt hote hain.
# Key lazmi exactly 64 hex chars (32 bytes) ho, warna server throw karega.
#  - generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Key badalne ka koi rotation rasta nahi — purana data decrypt nahi hoga,
# is liye is key ko sambhal ke rakho aur kabhi mat badlo.
ENCRYPTION_KEY=change_me_to_64_hex_chars

# Cloudflare Turnstile bot protection.
# Key na ho to verification poori skip ho jati hai (koi warning nahi).
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Email templates me logo ke liye Cloudinary URL (optional).
LOGO_URL=https://res.cloudinary.com/<your-cloud>/image/upload/logo.png
