# Copy to .env and fill in real values
PORT=5000

# Browser origins allowed to call the API.
#  - comma-separated list, e.g. http://localhost:3000,http://192.168.1.5:3000
#    (add your LAN IP to test the UI from a phone)
#  - localhost / 127.0.0.1 / ::1 are always allowed on ANY port, so a dev
#    server that fell back to :3001 still works
#  - NEVER use "*" in a public repo; replace with a real domain or leave blank
#    (blank = dev default only)
CLIENT_ORIGIN=http://localhost:3000

# MongoDB connection string
#  - local:      mongodb://localhost:27017/asan_tijarat
#  - atlas:      mongodb+srv://<user>:<pass>@cluster.mongodb.net/asan_tijarat
MONGO_URI=mongodb://localhost:27017/asan_tijarat

# JWT signing secret (REQUIRED in production - no fallback)
#  - generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# SMTP email (for password reset / alerts)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=Asan Tijarat <noreply@asantijarat.pk>

# Admin seed account
ADMIN_SEED_EMAIL=admin@asantijarat.pk
ADMIN_SEED_PASSWORD=change_me_to_a_secure_admin_password
SEED_USER_PASSWORD=password123